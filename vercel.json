{
  "rewrites": [
    {
      "source": "/api/social-post",
      "destination": "/api/social?fn=post"
    },
    {
      "source": "/api/social-draft",
      "destination": "/api/social?fn=draft"
    },
    {
      "source": "/api/social-cron",
      "destination": "/api/social?fn=cron"
    },
    {
      "source": "/api/meta",
      "destination": "/api/social?fn=meta"
    },
    {
      "source": "/api/rzp-order",
      "destination": "/api/rzp?fn=order"
    },
    {
      "source": "/api/rzp-verify",
      "destination": "/api/rzp?fn=verify"
    },
    {
      "source": "/api/rzp-webhook",
      "destination": "/api/rzp?fn=webhook"
    }
  ],
  "redirects": [
    {
      "source": "/((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "aiappledoctor.vercel.app"
        }
      ],
      "destination": "https://sebsaathi.com/$1",
      "permanent": true
    },
    {
      "source": "/((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "sebsaathi.vercel.app"
        }
      ],
      "destination": "https://sebsaathi.com/$1",
      "permanent": true
    }
  ],
  "functions": {
    "api/social.js": {
      "maxDuration": 300
    }
  }
}
